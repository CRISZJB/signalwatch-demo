{
  "name": "signalwatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-env.mjs generate && next build",
    "build:render": "node scripts/prisma-env.mjs generate && next build",
    "start": "next start",
    "start:render": "node scripts/prisma-env.mjs migrate && next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema=prisma-postgres/schema.prisma",
    "db:generate": "node scripts/prisma-env.mjs generate",
    "db:print": "node scripts/prisma-env.mjs print",
    "smoke": "node scripts/smoke.mjs",
    "scheduler:worker": "node scripts/scheduler-worker.mjs",
    "scheduler:once": "node scripts/scheduler-worker.mjs --once",
    "evidence:dedup": "node --import tsx scripts/dedup-evidence.mjs",
    "postinstall": "node scripts/prisma-env.mjs generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.4.0",
    "next": "15.5.28",
    "prisma": "^5.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
