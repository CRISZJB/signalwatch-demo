# —— 本地开发（默认 SQLite，保留原有能力）——
DATABASE_URL="file:./dev.db"

# —— Render / 云端 PostgreSQL（部署时由平台注入，勿把真实密码写入仓库）——
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/signalwatch?sslmode=require"

NEXT_PUBLIC_APP_NAME="SignalWatch"
NEXT_PUBLIC_DATA_MODE="SIMULATED"

# 调度鉴权：生产环境务必设置
# SCHEDULER_SECRET="change-me-long-random"

# 服务端进程内调度（Render Web 单实例可开）
# ENABLE_SERVER_SCHEDULER=1
# SCHEDULER_INTERVAL_MS=20000

# 可选：重启后注入演示覆盖（JSON）。一般可依赖 SystemMeta 持久化。
# DEMO_MARKET_SEED_JSON={"fault":"none","overrides":{"600519":{"price":1650,"prevClose":1720}}}
